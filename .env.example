# ============================================================
# SentinelForge — Environment Configuration Template
# ============================================================

# App Configuration
APP_NAME=SentinelForge
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL) — Note: port 5433 to avoid conflicts with MAOP
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sentinelforge
POSTGRES_USER=sf_user
POSTGRES_PASSWORD=sf_secret_dev
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

# Cache & Online Feature Store (Redis) — Note: port 6380 to avoid conflicts
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
FEATURE_TTL_SECONDS=86400

# Message Broker (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=txn.stream
KAFKA_FLAGGED_TOPIC=case.flagged
KAFKA_CONSUMER_GROUP=sentinelforge-consumer-group

# LLM & Investigation (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Model Registry (MLflow) — Note: port 5001 to avoid conflicts
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=sentinelforge_fraud_detection

# Observability
PROMETHEUS_PORT=9091
METRICS_ENABLED=true

# Authentication & Security
JWT_SECRET_KEY=dev_secret_key_change_in_production_sentinelforge_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# Model Paths & Lifecycle
MODEL_CACHE_DIR=./model_cache
CURRENT_MODEL_VERSION=v1
CANARY_TRAFFIC_PERCENT=10
